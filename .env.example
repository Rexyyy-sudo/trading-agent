# ============================================================
# trading-agent environment variables
# Copy this file to .env and fill in ONLY what you need.
# The framework works fully offline with the CSV provider.
# NEVER commit your real .env file.
# ============================================================

# --- Market data providers (all optional) -------------------
# Twelve Data:  https://twelvedata.com   (free tier available)
TWELVE_DATA_API_KEY=

# Alpha Vantage: https://www.alphavantage.co  (free tier available)
ALPHA_VANTAGE_API_KEY=

# Generic market-data key (used as fallback for providers that
# accept a single "MARKET_DATA_API_KEY" style token).
MARKET_DATA_API_KEY=

# --- News / economic calendar (all optional) ----------------
# Finnhub: https://finnhub.io  (economic calendar may need a paid plan)
FINNHUB_API_KEY=

# Reserved for future news providers.
NEWS_API_KEY=

# --- LLM (optional) ------------------------------------------
# The deterministic engine NEVER requires an LLM.
# This key is reserved for future optional narrative generation.
LLM_API_KEY=

# --- Overrides (optional) ------------------------------------
# TRADING_AGENT_CONFIG=config/settings.yaml
